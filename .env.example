# De dónde saca los datos esta instalación del front (src/shared/api/fuente.ts).
# Copie este archivo a .env.local (no se versiona) y cambie lo que necesite.

# demo: los insumos de demostración se calculan en el navegador (por omisión).
# http: cada consulta es un GET y cada escritura un POST/PATCH al backend, con
#       las formas de src/shared/api/contrato.ts. El build no lleva los datos del demo.
VITE_FUENTE=demo

# La raíz de la API del backend. Con VITE_FUENTE=http:
# - absoluta (http://servidor:8080/api): en desarrollo (npm run dev) Vite manda
#   /api a esta dirección con su proxy (sin CORS) y el simulador del registro no
#   se monta; en un build el front pide directo aquí y la política de seguridad
#   agrega su origen a connect-src;
# - relativa (/api): el mismo dominio del front, en desarrollo y en el build; la
#   política ya lo cubre. Sin definir es /api.
# Otra cosa (sin http:// ni /) detiene el build diciendo qué se esperaba.
# VITE_API_URL=http://localhost:8080/api
