  "reglas": [
    { "de": "(\\d{1,2}) de ene\\b", "a": "Jan $1" },
    { "de": "(\\d{1,2}) de feb\\b", "a": "Feb $1" },
    { "de": "(\\d{1,2}) de mar\\b", "a": "Mar $1" },
    { "de": "(\\d{1,2}) de abr\\b", "a": "Apr $1" },
    { "de": "(\\d{1,2}) de may\\b", "a": "May $1" },
    { "de": "(\\d{1,2}) de jun\\b", "a": "Jun $1" },
    { "de": "(\\d{1,2}) de jul\\b", "a": "Jul $1" },
    { "de": "(\\d{1,2}) de ago\\b", "a": "Aug $1" },
    { "de": "(\\d{1,2}) de sept?\\b", "a": "Sep $1" },
    { "de": "(\\d{1,2}) de oct\\b", "a": "Oct $1" },
    { "de": "(\\d{1,2}) de nov\\b", "a": "Nov $1" },
    { "de": "(\\d{1,2}) de dic\\b", "a": "Dec $1" },
    { "de": "\\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) (\\d{1,2}) de (\\d{4})\\b", "a": "$1 $2, $3" },
    { "de": "^Octubre (\\d{4})$", "a": "October $1" },
    { "de": "^hoy, ", "a": "today, " },
    { "de": "^Venía del ([^·]+) · sigue$", "a": "Since $1 · ongoing" },
    { "de": "^Venía de las (\\d\\d:\\d\\d) · sigue$", "a": "Since $1 · ongoing" },
    { "de": "^Venía del ([^·]+) · terminó (.+)$", "a": "Since $1 · ended $2" },
    { "de": "^Empezó (\\d\\d:\\d\\d) · sigue$", "a": "Started $1 · ongoing" },
    { "de": "^e (\\d\\d:\\d\\d) a (\\d\\d:\\d\\d) del (.+)$", "a": "rom $1 to $2, $3" },
    { "de": "^desde (.+)$", "a": "since $1" },
    { "de": "^meta (.+)$", "a": "target $1" },
    { "de": "^· máximo (.+)$", "a": "· max $1" },
    { "de": "^(\\S+) mil USD$", "a": "USD $1k" },
    { "de": "^(\\S+) M USD$", "a": "USD $1M" },
    { "de": "^los (\\d+) meses$", "a": "the $1 months" },
    { "de": "^los (\\d+) turnos$", "a": "the $1 shifts" },
    { "de": "^(\\d+) de (\\d+) en marcha$", "a": "$1 of $2 running" },
    { "de": "^(\\d+) fallas · una cada (\\d+) días$", "a": "$1 failures · one every $2 days" },
    { "de": "^(\\S+) bbl por falla, en promedio$", "a": "$1 bbl per failure, on average" },
    { "de": "^Volver antes de (.+)$", "a": "Back within $1" },
    { "de": "^Ver (\\d+) planes más$", "a": "See $1 more plans" },
    { "de": "^Ver (P-\\S+|LC-\\S+|MPP-\\S+|K-\\S+)$", "a": "View $1" },
    { "de": "^Confirmar (\\d+) paradas iguales$", "a": "Confirm $1 matching stops" },
    { "de": "^Conseguir la causa de (\\d+) paradas?$", "a": "Get the cause of $1 stops" },
    { "de": "^Decidir (\\d+) planes de (\\S+) · simulado$", "a": "Decide $1 plans for $2 · simulated" },
    { "de": "^cerró (\\S+) y (\\S+) · (\\d\\d:\\d\\d)$", "a": "shut in $1 and $2 · $3" },
    { "de": "^(·\\s*)?([A-Z]+-\\w+(?:, [A-Z]+-\\w+)*) y ([A-Z]+-\\w+)$", "a": "$1$2 and $3" },
    { "de": "^(\\d+) pozos$", "a": "$1 wells" },
    { "de": "^(\\d+) de sus (\\d+) fallas$", "a": "$1 of its $2 failures" },
    { "de": "^criticidad (\\d) de (\\d)$", "a": "criticality $1 of $2" },
    { "de": "^caída de presión del filtro · alarma en (.+)$", "a": "filter pressure drop · alarm in $1" },
    { "de": "^vibración · cruza en ([^·]+) · ([^·]+) · \\+(\\d+) señal(es)?$", "a": "vibration · crosses in $1 · $2 · +$3 signal" },
    { "de": "^(·\\s*)?en (\\S+ d)\\b", "a": "$1in $2" },
    { "de": "^hace (.+)$", "a": "$1 ago" },
    { "de": "^Espera que se identifique el daño · hace (.+)$", "a": "Waiting for the failure to be identified · $1 ago" }
  ],
  "contexto": [
    { "texto": "d", "siguiente": "^(e|rom) \\d\\d:\\d\\d", "a": "f" }
  ],
